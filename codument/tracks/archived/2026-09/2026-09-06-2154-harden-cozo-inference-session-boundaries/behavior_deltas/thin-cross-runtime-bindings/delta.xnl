<BehaviorPatch #track.harden-cozo-inference-session-boundaries.behavior_patch.thin-cross-runtime-bindings apiVersion="codument.tech/v1alpha1" version="1" { capability = "thin-cross-runtime-bindings" } (
  <Mutations [
    <Upsert { selector = "behavior://thin-cross-runtime-bindings/requirements/inference-session-boundaries" } (
      <Requirement #inference-session-boundaries (
        <Statement ?>数据库 SHALL 隔离事务终态和并行查询，超时后仍可使用会话。</?>
        <Suites [
          <Suite #lifecycle { name = "会话生命周期" } (
            <Cases [
              <Case #rollback-close (
                <Given ?>真实 mem 数据库存在未提交事务</?>
                <When ?>关闭空闲会话</?>
                <Then ?>未提交数据不可见且终止句柄拒绝查询。</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
