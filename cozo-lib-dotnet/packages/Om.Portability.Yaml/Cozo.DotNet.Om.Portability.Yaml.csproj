<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Cozo.DotNet.Om.Portability.Yaml</PackageId>
    <Version>0.7.6</Version>
    <Authors>Ziyang Hu</Authors>
    <Description>Safe, bounded YAML adapter for Cozo .NET OM behavior manifests.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cozodb/cozo</RepositoryUrl>
    <PackageProjectUrl>https://www.cozodb.org</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Cozo.DotNet.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
