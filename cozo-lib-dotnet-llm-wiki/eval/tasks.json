{
  "version": 1,
  "description": "Eval baseline task set (track add-llm-wiki-eval-baseline). Every question is a real question about one of the two work roots; workRoot is the repository-relative path from the directory containing both repos (cozo-lib-dotnet-llm-wiki, cozo-lib-dotnet/src). tools is the suggested tool sequence for the oracle mode; must/should are the weighted answer keywords for EvalScorer (0.8/0.2, case-insensitive containment, long real identifiers only). Oracle query convention: without embeddings the BM25 channel matches whole identifier tokens against declaration text (name + signature), so 'which API/who calls X' recipes include the candidate identifier in the query — the graph evidence being validated is the returned symbol hit with its path:line source id, not the token echo (trace/check/depa outputs supply the relation-level evidence). The oracle enforces this: input-echo fields (query/rootId/targetId/reason) are stripped from every tool output before scoring, so a must hit can only come from returned graph evidence.",
  "tasks": [
    {
      "id": "eval-001",
      "question": "谁调用了 RepositoryIndexer.IndexAsync？（workRoot: cozo-lib-dotnet-llm-wiki）",
      "difficulty": "easy",
      "workRoot": "cozo-lib-dotnet-llm-wiki",
      "tools": [
        { "name": "semantic_search", "arguments": { "query": "RepositoryIndexer IndexAsync callers", "limit": "5" } },
        { "name": "trace", "arguments": { "from": "CallAsync", "to": "IndexAsync" } }
      ],
      "must": ["LlmWikiToolRunner", "RepositoryIndexer"],
      "should": ["index_repo", "McpServer"]
    },
    {
