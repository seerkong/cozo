<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cozo.DotNet.LlmWiki.Core\Cozo.DotNet.LlmWiki.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests exercise internal surface (extractors, query infra, native backend members); same pattern as Cozo.DotNet.csproj. -->
    <InternalsVisibleTo Include="Cozo.DotNet.LlmWiki.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- tree-sitter native libraries in NuGet runtimes layout (same pattern as cozo-lib-dotnet).
         Rebuild with scripts/build-native-parsers.sh (pinned commits). -->
    <None Include="runtimes/osx-arm64/native/*" Exclude="**/.gitkeep" Pack="true" PackagePath="runtimes/osx-arm64/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
